#!/usr/bin/env python3
"""CLI launcher for agy-sessions (symlinked into ~/.local/bin/agy-sessions)."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from agy_sessions.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
